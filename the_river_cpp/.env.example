# Copy this file to .env.local or tor_data/runtime.env and replace every value.
# Keep the real file private and outside Git.

THE_RIVER_ONION=replace-with-hidden-service-hostname.onion
THE_RIVER_AES_KEY=replace-with-at-least-32-random-characters
THE_RIVER_ADMIN_USER=admin
THE_RIVER_ADMIN_BOOTSTRAP_PASSWORD=replace-with-strong-admin-bootstrap-key
THE_RIVER_NEW_USER_PASSWORD=replace-with-strong-initial-user-key
THE_RIVER_BIND_ADDR=127.0.0.1
THE_RIVER_DB=secure_river.db
THE_RIVER_LOG=chat_history.log

# Optional. If omitted, clients generate .the_river_machine_id locally.
# THE_RIVER_MACHINE_ID_FILE=.the_river_machine_id
