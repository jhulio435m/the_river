# Puerto Proxy (por si quieres navegar desde esta PC usando Tor)
SocksPort 9050

# Ruta a los archivos geoip (importante para que Tor sepa dónde está)
GeoIPFile .\geoip
GeoIPv6File .\geoip6

# Donde se guardará tu dirección .onion
HiddenServiceDir .\identidad\

# Redirección: Puerto 80 (.onion) -> Puerto 8888 (Tu programa VB)
HiddenServicePort 80 127.0.0.1:8888